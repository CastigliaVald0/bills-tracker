# Conexión a Postgres. En producción, la connection string de Neon (u otro proveedor).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Firma las sesiones. Generar con: openssl rand -base64 33
AUTH_SECRET="generate-with-openssl-rand-base64-33"

# Obligatorio en producción: protege /api/cron/generate-recurring, que genera
# gastos para todos los usuarios. Sin esto el endpoint rechaza todo.
# Generar con: openssl rand -base64 33
CRON_SECRET="generate-with-openssl-rand-base64-33"

# SMTP para el mail de recuperación de contraseña. Sirve cualquier proveedor.
# Sin esto, la app funciona igual pero nadie puede recuperar su contraseña.
# Ver el README para las opciones gratuitas (Gmail, Brevo).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tu-cuenta@gmail.com"
SMTP_PASSWORD="contraseña-de-aplicacion"
SMTP_FROM="Billions Tracker <tu-cuenta@gmail.com>"

# A quién avisar cuando alguien se registra. Usa el mismo SMTP de arriba.
# Vacío o sin definir = no se manda ningún aviso.
ADMIN_NOTIFY_EMAIL="tu-cuenta@gmail.com"
