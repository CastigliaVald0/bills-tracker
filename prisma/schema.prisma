generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  UYU
  USD
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  name                String?
  createdAt           DateTime             @default(now())
  categories          Category[]
  expenses            Expense[]
  recurringExpenses   RecurringExpense[]
  passwordResetTokens PasswordResetToken[]
  pushSubscriptions   PushSubscription[]

  /// Resúmenes por mail (el del mes y, el 1 de enero, el del año). Activado por
  /// defecto; se desactiva desde Mi cuenta.
  notifyMonthlyEmail   Boolean @default(true)
  /// Los mismos resúmenes como notificación en sus dispositivos. Activado por
  /// defecto: al entrar a la app se pide el permiso del navegador una vez.
  notifyMonthlyPush    Boolean @default(true)
  /// Último mes ("2026-09") del que ya se mandó el aviso. Evita duplicados si el
  /// cron corre más de una vez el mismo día.
  monthlyNoticeSentFor String?
  /// Último año ("2026") del que ya se mandó el resumen anual del 1 de enero.
  annualNoticeSentFor  String?
}

/// Ventana fija de intentos por clave (ej. "login:mail@x.com", "register-ip:1.2.3.4").
model RateLimit {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

/// Token de recuperación de contraseña. Se guarda solo el hash: si alguien lee la
/// base, no puede reconstruir el link de reseteo.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  color             String             @default("#64748b")
  createdAt         DateTime           @default(now())
  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  @@unique([userId, name])
}

model Expense {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId         String
  category           Category          @relation(fields: [categoryId], references: [id])
  amount             Decimal           @db.Decimal(12, 2)
  currency           Currency
  date               DateTime
  description        String?
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  /// Cotización del dólar (venta) del día en que se cargó el gasto. Solo se
  /// guarda en gastos en USD: es lo que costaba ese dólar entonces, y queda
  /// congelado para siempre. Null en gastos en pesos, en los anteriores a esta
  /// columna, y cuando no se pudo leer la cotización al crearlos.
  usdRate            Decimal?          @db.Decimal(12, 4)

  @@index([userId, date])
}

model RecurringExpense {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  amount      Decimal   @db.Decimal(12, 2)
  currency    Currency
  dayOfMonth  Int
  description String?
  active      Boolean   @default(true)
  /// Último mes que se genera, inclusive (se guarda el día 1 en UTC).
  /// Null = sin fin, como un alquiler. Con valor = cuotas.
  endsOn      DateTime?
  createdAt   DateTime  @default(now())
  expenses    Expense[]

  @@index([userId, active])
}

/// Un dispositivo (navegador) que aceptó recibir notificaciones push. Un usuario
/// puede tener varios: el celular y la PC, por ejemplo.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Dirección del servicio de push del navegador (Google, Mozilla, Apple...).
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}
