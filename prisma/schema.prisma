generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  UYU
  USD
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  name                String?
  createdAt           DateTime             @default(now())
  categories          Category[]
  expenses            Expense[]
  recurringExpenses   RecurringExpense[]
  passwordResetTokens PasswordResetToken[]
  pushSubscriptions   PushSubscription[]
  grupos              Grupo[]
  membresias          MiembroGrupo[]       @relation("Membresias")
  invitacionesHechas  MiembroGrupo[]       @relation("InvitacionesHechas")
  gastosPagados       GastoGrupal[]        @relation("GastosPagados")
  gastosCargados      GastoGrupal[]        @relation("GastosCargados")
  partesDeGastos      ParteGasto[]
  pagosHechos         PagoGrupo[]          @relation("PagosHechos")
  pagosRecibidos      PagoGrupo[]          @relation("PagosRecibidos")
  pagosRegistrados    PagoGrupo[]          @relation("PagosRegistrados")
  aportesHechos       AporteMeta[]         @relation("AportesHechos")
  aportesRegistrados  AporteMeta[]         @relation("AportesRegistrados")

  /// Código corto para que otro te agregue, y que también es tu enlace de
  /// invitación. Se genera la primera vez que entrás a Amigos, así las cuentas
  /// que ya existían no necesitan migración de datos.
  codigoAmigo         String?              @unique
  /// Si no está prendido, solo te pueden agregar con el código. Apagado por
  /// defecto: aparecer en una búsqueda es algo que se elige, no que se sufre.
  buscablePorNombre   Boolean              @default(false)
  amistadesEnviadas   Amistad[]            @relation("AmistadesEnviadas")
  amistadesRecibidas  Amistad[]            @relation("AmistadesRecibidas")

  /// Resúmenes por mail (el del mes y, el 1 de enero, el del año). Activado por
  /// defecto; se desactiva desde Mi cuenta.
  notifyMonthlyEmail   Boolean @default(true)
  /// Los mismos resúmenes como notificación en sus dispositivos. Activado por
  /// defecto: al entrar a la app se pide el permiso del navegador una vez.
  notifyMonthlyPush    Boolean @default(true)
  /// Último mes ("2026-09") del que ya se mandó el aviso. Evita duplicados si el
  /// cron corre más de una vez el mismo día.
  monthlyNoticeSentFor String?
  /// Último año ("2026") del que ya se mandó el resumen anual del 1 de enero.
  annualNoticeSentFor  String?
}

/// Ventana fija de intentos por clave (ej. "login:mail@x.com", "register-ip:1.2.3.4").
model RateLimit {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

/// Token de recuperación de contraseña. Se guarda solo el hash: si alguien lee la
/// base, no puede reconstruir el link de reseteo.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  color             String             @default("#64748b")
  /// Un emoji que la representa en el círculo de las listas. Opcional: sin
  /// él se ve el ícono (si es una de las que trae la cuenta) o la inicial.
  emoji             String?
  createdAt         DateTime           @default(now())
  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  @@unique([userId, name])
}

model Expense {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId         String
  category           Category          @relation(fields: [categoryId], references: [id])
  amount             Decimal           @db.Decimal(12, 2)
  currency           Currency
  date               DateTime
  description        String?
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  /// Cotización del dólar (venta) del día en que se cargó el gasto. Solo se
  /// guarda en gastos en USD: es lo que costaba ese dólar entonces, y queda
  /// congelado para siempre. Null en gastos en pesos, en los anteriores a esta
  /// columna, y cuando no se pudo leer la cotización al crearlos.
  usdRate            Decimal?          @db.Decimal(12, 4)

  /// Si es la parte de este usuario en un gasto de grupo. Al borrar el gasto
  /// del grupo se borra también esta parte (ver la ruta de borrado).
  gastoGrupalId      String?
  gastoGrupal        GastoGrupal?      @relation(fields: [gastoGrupalId], references: [id], onDelete: SetNull)
  /// Si el gasto pertenece a un grupo. Sigue siendo un gasto personal más (suma
  /// en el mes como cualquier otro); el grupo solo lo agrupa y lo muestra aparte.
  /// Al borrar el grupo el gasto no se pierde: queda como gasto común.
  grupoId            String?
  grupo              Grupo?            @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  /// La sección del grupo (los "mini grupos": Cocina, Baño...). Null = sin sección.
  seccionId          String?
  seccion            SeccionGrupo?     @relation(fields: [seccionId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([grupoId])
  @@index([gastoGrupalId])
}

model RecurringExpense {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  amount      Decimal   @db.Decimal(12, 2)
  currency    Currency
  dayOfMonth  Int
  description String?
  active      Boolean   @default(true)
  /// Último mes que se genera, inclusive (se guarda el día 1 en UTC).
  /// Null = sin fin, como un alquiler. Con valor = cuotas.
  endsOn      DateTime?
  createdAt   DateTime  @default(now())
  expenses    Expense[]

  @@index([userId, active])
}

/// Un dispositivo (navegador) que aceptó recibir notificaciones push. Un usuario
/// puede tener varios: el celular y la PC, por ejemplo.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Dirección del servicio de push del navegador (Google, Mozilla, Apple...).
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// La última cotización que se pudo leer, para servirla si BROU y BCU fallan.
/// Una sola fila: el id es siempre "actual".
model UsdRateCache {
  id        String   @id @default("actual")
  source    String
  compra    Decimal  @db.Decimal(12, 4)
  venta     Decimal  @db.Decimal(12, 4)
  /// La fecha que publica la fuente, cuando la publica (BCU sí, BROU no).
  date      String?
  updatedAt DateTime @updatedAt
}

enum EstadoAmistad {
  pendiente
  aceptada
  rechazada
}

/// Una solicitud de amistad y su desenlace. La fila se guarda en la dirección
/// en que se mandó; quién la mandó importa para saber a quién le toca
/// responder y para que el rechazado no pueda insistir.
model Amistad {
  id             String        @id @default(cuid())
  solicitanteId  String
  solicitante    User          @relation("AmistadesEnviadas", fields: [solicitanteId], references: [id], onDelete: Cascade)
  destinatarioId String
  destinatario   User          @relation("AmistadesRecibidas", fields: [destinatarioId], references: [id], onDelete: Cascade)
  estado         EstadoAmistad @default(pendiente)
  createdAt      DateTime      @default(now())
  respondidaEn   DateTime?

  @@unique([solicitanteId, destinatarioId])
  @@index([destinatarioId, estado])
  @@index([solicitanteId, estado])
}

/// Ya no se usa: todos los grupos son iguales y las herramientas se prenden
/// adentro de cada uno. Queda en la base hasta la migración de herramientas,
/// que lo reemplaza.
enum TipoGrupo {
  proyecto
  compartido
  meta
}

/// Un grupo de gastos: todo lo que se gasta en algo puntual, como la obra de
/// una casa o un viaje.
model Grupo {
  id          String         @id @default(cuid())
  creadorId   String
  creador     User           @relation(fields: [creadorId], references: [id], onDelete: Cascade)
  nombre      String
  /// Ya no se usa (ver TipoGrupo).
  tipo        TipoGrupo      @default(proyecto)
  color       String         @default("#6fbee4")
  descripcion String?
  /// Si el grupo se divide en secciones. Se elige al crearlo; uno sin
  /// secciones muestra sus gastos en una sola lista.
  usaSecciones Boolean       @default(true)
  /// Con valor, el grupo está archivado: no se le cargan gastos y sale de la
  /// lista principal, pero se puede seguir consultando.
  archivadoEn DateTime?
  /// La meta de ahorro: cuánto quieren juntar entre todos (por ejemplo, para
  /// un viaje). Sin valor, el grupo no tiene meta.
  metaMonto   Decimal?       @db.Decimal(12, 2)
  /// En qué moneda es la meta. No cambia mientras haya aportes anotados.
  metaMoneda  Currency       @default(UYU)
  createdAt   DateTime       @default(now())
  secciones   SeccionGrupo[]
  gastos      Expense[]
  miembros    MiembroGrupo[]
  gastosGrupales GastoGrupal[]
  pagos       PagoGrupo[]
  aportes     AporteMeta[]

  @@index([creadorId, archivadoEn])
}

/// Una división dentro de un grupo: los ambientes de la casa, las etapas del
/// viaje. Un solo nivel.
model SeccionGrupo {
  id        String    @id @default(cuid())
  grupoId   String
  grupo     Grupo     @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  nombre    String
  /// Color propio de la sección. Sin él, se usa el del grupo.
  color     String?
  /// Un emoji que la representa en el mosaico y en los gastos. Opcional.
  emoji     String?
  /// Posición en la lista, en el orden en que se crearon.
  orden     Int       @default(0)
  createdAt DateTime  @default(now())
  gastos    Expense[]
  gastosGrupales GastoGrupal[]

  @@unique([grupoId, nombre])
}

enum EstadoMiembro {
  pendiente
  aceptado
}

/// Un amigo sumado a un grupo. Quien crea el grupo no tiene fila acá: es el
/// administrador y siempre es miembro. Los demás entran invitados y recién
/// cuentan cuando aceptan.
model MiembroGrupo {
  id            String        @id @default(cuid())
  grupoId       String
  grupo         Grupo         @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation("Membresias", fields: [userId], references: [id], onDelete: Cascade)
  invitadoPorId String
  invitadoPor   User          @relation("InvitacionesHechas", fields: [invitadoPorId], references: [id], onDelete: Cascade)
  estado        EstadoMiembro @default(pendiente)
  createdAt     DateTime      @default(now())
  respondidoEn  DateTime?

  @@unique([grupoId, userId])
  @@index([userId, estado])
}

/// Un gasto del grupo, tal como pasó: quién pagó y cuánto. Cómo se reparte
/// está en sus partes, y cada parte es además un gasto personal (Expense) de
/// quien la debe: eso es lo que suma en su mes.
model GastoGrupal {
  id           String        @id @default(cuid())
  grupoId      String
  grupo        Grupo         @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  seccionId    String?
  seccion      SeccionGrupo? @relation(fields: [seccionId], references: [id], onDelete: SetNull)
  pagadorId    String
  pagador      User          @relation("GastosPagados", fields: [pagadorId], references: [id], onDelete: Cascade)
  cargadoPorId String
  cargadoPor   User          @relation("GastosCargados", fields: [cargadoPorId], references: [id], onDelete: Cascade)
  monto        Decimal       @db.Decimal(12, 2)
  moneda       Currency
  fecha        DateTime
  descripcion  String?
  /// Cotización del día, como en Expense: solo en gastos en dólares.
  usdRate      Decimal?      @db.Decimal(12, 4)
  createdAt    DateTime      @default(now())
  partes       ParteGasto[]
  gastos       Expense[]

  @@index([grupoId, fecha])
}

/// Cuánto le toca a cada uno de un gasto del grupo. Las partes de un gasto
/// suman exactamente su monto.
model ParteGasto {
  id            String      @id @default(cuid())
  gastoGrupalId String
  gastoGrupal   GastoGrupal @relation(fields: [gastoGrupalId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  monto         Decimal     @db.Decimal(12, 2)

  @@unique([gastoGrupalId, userId])
  @@index([userId])
}

/// Plata que un miembro le devolvió a otro dentro del grupo. Baja los saldos;
/// no es un gasto nuevo, porque la parte de cada uno ya se contó cuando se
/// cargó el gasto.
model PagoGrupo {
  id               String   @id @default(cuid())
  grupoId          String
  grupo            Grupo    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  deId             String
  de               User     @relation("PagosHechos", fields: [deId], references: [id], onDelete: Cascade)
  aId              String
  a                User     @relation("PagosRecibidos", fields: [aId], references: [id], onDelete: Cascade)
  monto            Decimal  @db.Decimal(12, 2)
  moneda           Currency
  fecha            DateTime
  registradoPorId  String
  registradoPor    User     @relation("PagosRegistrados", fields: [registradoPorId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@index([grupoId])
}

/// Plata que un integrante puso para la meta de ahorro del grupo. No es un
/// gasto: no suma en el mes de nadie ni cambia los saldos entre personas.
model AporteMeta {
  id               String   @id @default(cuid())
  grupoId          String
  grupo            Grupo    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  /// Quién puso la plata.
  userId           String
  user             User     @relation("AportesHechos", fields: [userId], references: [id], onDelete: Cascade)
  /// En la moneda de la meta al momento de anotarlo.
  monto            Decimal  @db.Decimal(12, 2)
  moneda           Currency @default(UYU)
  fecha            DateTime
  /// Quién lo anotó (puede ser otro integrante).
  registradoPorId  String
  registradoPor    User     @relation("AportesRegistrados", fields: [registradoPorId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@index([grupoId, fecha])
}
